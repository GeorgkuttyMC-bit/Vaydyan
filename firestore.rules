rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Primitive Helpers
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Consultations Collection
    function isValidConsultation(data) {
      let hasRequired = data.keys().hasAll(['patientName', 'status', 'chiefComplaint', 'createdAt', 'updatedAt']);
      return hasRequired 
        && data.patientName is string && data.patientName.size() <= 128
        && data.status in ['pending', 'completed']
        && data.chiefComplaint is string && data.chiefComplaint.size() <= 2000
        && data.createdAt is string
        && data.updatedAt is string;
    }
    
    match /consultations/{consultationId} {
      // Open read access so users can view their history by name
      allow read: if true;

      allow create: if isValidId(consultationId)
        && isValidConsultation(incoming())
        && incoming().status in ['pending', 'completed']
        // Optional fields sizing
        && (!('healthContext' in incoming()) || (incoming().healthContext is string && incoming().healthContext.size() <= 5000))
        && (!('lifestyle' in incoming()) || (incoming().lifestyle is string && incoming().lifestyle.size() <= 5000))
        && (!('remedy' in incoming()) || (incoming().remedy is string && incoming().remedy.size() <= 20000));

      allow update: if (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'remedy', 'updatedAt'])
        && incoming().status in ['pending', 'completed']
        && incoming().remedy is string && incoming().remedy.size() <= 20000
        && incoming().updatedAt is string
      );
      
      allow delete: if true; // Admin can delete
    }
  }
}
